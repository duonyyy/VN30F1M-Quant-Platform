# Runtime environment
VN30F1M_ENV=local
VN30F1M_PROJECT_NAME=VN30F1M Quant Platform
VN30F1M_DEFAULT_SYMBOL=VN30F1M
VN30F1M_TIMEZONE=Asia/Ho_Chi_Minh

# Phase 01 canonical data decisions
VN30F1M_SOURCE_TIMEFRAME=1m
VN30F1M_CANONICAL_TIMEFRAME=15m
VN30F1M_STORAGE_BACKEND=local

# Kafka is required for the MVP ingestion path
VN30F1M_KAFKA_ENABLED=true
VN30F1M_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VN30F1M_KAFKA_RAW_TOPIC=vn30f1m.ohlcv.raw
VN30F1M_KAFKA_CONSUMER_GROUP=vn30f1m-batch-consumer

# Serving is optional for the first local run
VN30F1M_CLICKHOUSE_ENABLED=false
VN30F1M_CLICKHOUSE_URL=http://localhost:8123

# DNSE market-data client (Phase 04)
# Keep credentials local; never commit a populated .env file.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_TOKEN=
DNSE_OPENAPI_URL=https://openapi.dnse.com.vn
DNSE_PUBLIC_URL=https://api.dnse.com.vn
DNSE_API_VERSION=2026-05-07
DNSE_TIMEOUT_SECONDS=30
DNSE_MAX_RETRIES=3
DNSE_BACKOFF_FACTOR=0.5
